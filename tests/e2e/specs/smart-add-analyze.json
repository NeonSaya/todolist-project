{
  "version": 1,
  "spec": {
    "id": "smart-add-analyze",
    "kind": "interactive",
    "goal": "With AI configured, pasted text becomes 3 editable suggestions that are added in bulk and appear in the 全部 view",
    "requirementIndexes": [],
    "acceptanceCriteriaIndexes": [],
    "steps": [
      "Open AI 设置",
      "Save the settings with 接口地址 https://api.openai.com/v1, API Key sk-test-123 and 模型名称 gpt-4o-mini",
      "Open 智能添加",
      "Paste 明天下午三点和王总开会，周五前交季度报告，记得买牛奶 into the text area and press 分析",
      "Confirm and add the checked suggestions",
      "Open the 全部 view"
    ],
    "checks": [
      {
        "afterStep": 0,
        "expectText": "API Key"
      },
      {
        "afterStep": 1,
        "expectText": "API Key"
      },
      {
        "afterStep": 2,
        "expectRole": {
          "role": "button",
          "name": "分析"
        }
      },
      {
        "afterStep": 3,
        "expectText": "3"
      },
      {
        "afterStep": 4,
        "expectText": "已添加 3 条任务"
      },
      {
        "afterStep": 5,
        "expectText": "买牛奶"
      },
      {
        "afterStep": 5,
        "expectText": "交季度报告"
      }
    ],
    "mocks": {
      "http": [
        {
          "url": "https://api.openai.com/v1/chat/completions",
          "status": 200,
          "json": {
            "choices": [
              {
                "finish_reason": "stop",
                "index": 0,
                "message": {
                  "content": "{\"tasks\":[{\"title\":\"和王总开会\",\"date\":\"2030-06-15\",\"priority\":\"high\",\"note\":\"下午三点\"},{\"title\":\"交季度报告\",\"date\":\"2030-06-18\",\"priority\":\"high\",\"note\":null},{\"title\":\"买牛奶\",\"date\":null,\"priority\":\"low\",\"note\":null}]}",
                  "role": "assistant"
                }
              }
            ],
            "id": "mock",
            "object": "chat.completion"
          }
        }
      ]
    }
  }
}
