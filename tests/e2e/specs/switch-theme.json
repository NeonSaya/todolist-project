{
  "version": 1,
  "spec": {
    "id": "switch-theme",
    "kind": "interactive",
    "goal": "Switch to the dark theme and keep it after a reload",
    "requirementIndexes": [
      0,
      1,
      2,
      3,
      4,
      5,
      6,
      7
    ],
    "acceptanceCriteriaIndexes": [
      1,
      2
    ],
    "steps": [
      "Press the 切换主题 button",
      "Choose 深色",
      "Reload the page"
    ],
    "checks": [
      {
        "afterStep": 0,
        "expectText": "跟随系统"
      },
      {
        "afterStep": 1,
        "expectText": "把纷乱拾成秩序"
      },
      {
        "afterStep": 1,
        "assert": "The app now shows a dark background with readable light text"
      },
      {
        "afterStep": 2,
        "expectText": "把纷乱拾成秩序"
      },
      {
        "afterStep": 2,
        "assert": "The app is still in the dark theme after the reload"
      }
    ]
  }
}
