{
  "version": 1,
  "spec": {
    "id": "add-complete-task",
    "kind": "interactive",
    "goal": "Add a task, complete it and find it kept after a reload",
    "requirementIndexes": [
      8,
      9,
      10,
      12
    ],
    "acceptanceCriteriaIndexes": [
      0,
      3,
      4,
      7,
      8
    ],
    "steps": [
      "Add a task titled 整理书架 and press 添加",
      "Mark 整理书架 as done",
      "Reload the page",
      "Open the 今天 view"
    ],
    "checks": [
      {
        "afterStep": 0,
        "expectText": "整理书架"
      },
      {
        "afterStep": 0,
        "assert": "The sidebar highlights the 今天 view and shows task counts beside 今天, 即将到来 and 逾期"
      },
      {
        "afterStep": 1,
        "expectText": "已完成"
      },
      {
        "afterStep": 2,
        "expectText": "把纷乱拾成秩序"
      },
      {
        "afterStep": 3,
        "expectText": "整理书架"
      }
    ]
  }
}
